#!/bin/sh
# Runs before the board starts.

# No Erlang remote connections unless asked for. Every copy of a download has
# the same cookie in releases/COOKIE, so with them on, anyone on the network
# who has the download could run commands on this machine. The Mac app and
# systemd.sh already turn them off; this covers starting the board by hand.
export RELEASE_DISTRIBUTION="${RELEASE_DISTRIBUTION:-none}"

# No crash dump files. A dump copies memory to disk, and memory holds the
# New Relic key, which must never be written to a file.
export ERL_CRASH_DUMP_BYTES=0

# Keep OpenSSL to the copy inside the board. Without this it also loads its
# optional "legacy" add-on from Homebrew when Homebrew is there, so the board
# would behave differently on a Mac without Homebrew. The board never needs
# the old ciphers that add-on holds.
export OPENSSL_MODULES="$RELEASE_ROOT/lib/no-openssl-modules"
