#!/bin/sh
# Runs before the board starts.

# No Erlang remote connections unless asked for. Every copy of a download has
# the same cookie in releases/COOKIE, so with them on, anyone on the network
# who has the download could run commands on this machine. The Mac app and
# systemd.sh already turn them off; this covers starting the board by hand.
export RELEASE_DISTRIBUTION="${RELEASE_DISTRIBUTION:-none}"

# No crash dump files. A dump copies memory to disk, and memory holds the
# New Relic key, which must never be written to a file.
export ERL_CRASH_DUMP_BYTES=0

# Keep OpenSSL to the copy inside the board. Without this it also loads its
# optional "legacy" add-on from Homebrew when Homebrew is there, so the board
# would behave differently on a Mac without Homebrew. The board never needs
# the old ciphers that add-on holds.
export OPENSSL_MODULES="$RELEASE_ROOT/lib/no-openssl-modules"

# A collector stays small: it loads only the code it uses (the board's code
# is in the download but never loaded) and runs on two threads, not one per
# processor. Measured on a Mac, that is about 80 MB when idle in place of
# about 165 MB.
#
# The role comes from WALLBOARD_ROLE or, failing that, from the saved
# settings (settings.json, which the Mac app and vitalaize setup write) or,
# failing that, from a plain
#   role: "collector"
# line in the settings file. A role written any other way still works; it
# only misses this saving.
#
# The settings file is the first of these that is there, and settings.json
# sits beside it; with none there, beside the first place it would be
# looked for. This is the same order as Wallboard.Settings.file_place/0
# and saved_path/0: keep the two alike.
vitalaize_role="${WALLBOARD_ROLE:-}"
vitalaize_file=
vitalaize_place=
for vitalaize_try in "${WALLBOARD_SETTINGS:-}" "$RELEASE_ROOT/settings.exs" "./settings.exs"; do
  [ -n "$vitalaize_try" ] || continue
  [ -n "$vitalaize_place" ] || vitalaize_place="$vitalaize_try"
  if [ -f "$vitalaize_try" ]; then
    vitalaize_file="$vitalaize_try"
    vitalaize_place="$vitalaize_try"
    break
  fi
done
if [ -z "$vitalaize_role" ]; then
  vitalaize_saved="${WALLBOARD_SAVED_SETTINGS:-$(dirname "$vitalaize_place")/settings.json}"
  if [ -f "$vitalaize_saved" ]; then
    vitalaize_role=$(sed -n 's/.*"role"[[:space:]]*:[[:space:]]*"\([a-z]*\)".*/\1/p' "$vitalaize_saved" | head -n 1)
  fi
fi
if [ -z "$vitalaize_role" ] && [ -n "$vitalaize_file" ]; then
  if grep -Eq '^[[:space:]]*role:[[:space:]]*"collector"' "$vitalaize_file"; then
    vitalaize_role=collector
  fi
fi
if [ "$vitalaize_role" = collector ]; then
  export RELEASE_MODE="${RELEASE_MODE:-interactive}"
  export ERL_AFLAGS="+S 2:2 +SDcpu 1:1 +SDio 2 +A 2 ${ERL_AFLAGS:-}"
fi
