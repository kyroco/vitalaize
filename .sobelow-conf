# Sobelow's settings, read by `mix sobelow --config`. CI fails on any finding
# at medium confidence or above, and ignores `# sobelow_skip` comments in the
# code: a finding is skipped only in `ignore` below, with the reason beside it.
[
  verbose: false,
  private: true,
  skip: false,
  router: "",
  exit: "medium",
  format: "txt",
  out: "",
  threshold: "medium",
  # Config.HTTPS: the board serves plain HTTP on purpose. It runs on a
  # home or office network and the iPad and other Macs reach it by its local
  # address, where there is no certificate to serve.
  ignore: ["Config.HTTPS"],
  ignore_files: [],
  version: false
]
